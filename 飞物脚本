-- ================= 主要 Page =================
local MainPage = Window:Page({Name = "主要", Icon = "rbxassetid://4483362458"})
local MainSection = MainPage:Section({Name = "主要功能", Side = 1})

-- 速度修改
getgenv().PlayerSpeed = 16
getgenv().KeepSpeed = false

MainSection:Slider({
    Name = "移动速度",
    Min = 16,
    Max = 500,
    Default = 16,
    Callback = function(value)
        getgenv().PlayerSpeed = value
        local char = game.Players.LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            char.Humanoid.WalkSpeed = value
        end
    end
})

MainSection:Toggle({
    Name = "锁定速度（防重置）",
    Default = false,
    Callback = function(state)
        getgenv().KeepSpeed = state
    end
})

-- 跳跃高度修改
getgenv().PlayerJump = 50
getgenv().KeepJump = false

MainSection:Slider({
    Name = "跳跃高度",
    Min = 50,
    Max = 500,
    Default = 50,
    Callback = function(value)
        getgenv().PlayerJump = value
        local char = game.Players.LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            char.Humanoid.JumpPower = value
            char.Humanoid.JumpHeight = value / 2 
        end
    end
})

MainSection:Toggle({
    Name = "锁定跳跃高度（防重置）",
    Default = false,
    Callback = function(state)
        getgenv().KeepJump = state
    end
})

-- ================= 穿墙功能 (Noclip) =================
getgenv().NoclipEnabled = false

MainSection:Toggle({
    Name = "穿墙 (Noclip)",
    Default = false,
    Callback = function(state)
        getgenv().NoclipEnabled = state
        if not state then
            local char = game.Players.LocalPlayer.Character
            if char then
                for _, v in pairs(char:GetDescendants()) do
                    if v:IsA("BasePart") then
                        v.CanCollide = true
                    end
                end
            end
        end
    end
})

-- 穿墙循环
game:GetService("RunService").Stepped:Connect(function()
    if getgenv().NoclipEnabled then
        local char = game.Players.LocalPlayer.Character
        if char then
            for _, v in pairs(char:GetDescendants()) do
                if v:IsA("BasePart") then
                    v.CanCollide = false
                end
            end
        end
    end
end)

-- 锁定循环
game:GetService("RunService").Heartbeat:Connect(function()
    local char = game.Players.LocalPlayer.Character
    if char and char:FindFirstChild("Humanoid") then
        local hum = char.Humanoid
        if getgenv().KeepSpeed and hum.WalkSpeed ~= getgenv().PlayerSpeed then
            hum.WalkSpeed = getgenv().PlayerSpeed
        end
        if getgenv().KeepJump then
            if hum.JumpPower ~= getgenv().PlayerJump then hum.JumpPower = getgenv().PlayerJump end
            if hum.JumpHeight ~= getgenv().PlayerJump / 2 then hum.JumpHeight = getgenv().PlayerJump / 2 end
        end
    end
end)

