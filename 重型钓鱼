-- 拖拽功能（用Frame的InputBegan/InputEnded，无缩放）
local dragging = false
local dragStart = nil
local frameStart = nil

DragHandle.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        frameStart = MusicInputFrame.Position
    end
end)

DragHandle.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

game:GetService("UserInputService").InputChanged:Connect(function(input)
    if dragging and dragStart and frameStart then
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            MusicInputFrame.Position = UDim2.new(
                frameStart.X.Scale,
                frameStart.X.Offset + delta.X,
                frameStart.Y.Scale,
                frameStart.Y.Offset + delta.Y
            )
        end
    end
end)

-- 播放按钮
PlayIDBtn.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        local newID = MusicIDBox.Text
        if newID ~= "" then
            getgenv().MusicID = newID
            if Sound then
                Sound:Stop()
                Sound:Destroy()
            end
            Sound = Instance.new("Sound")
            Sound.SoundId = "rbxassetid://" .. newID
            Sound.Volume = getgenv().MusicVolume or 0.5
            Sound.Looped = true
            Sound.Parent = lp.PlayerGui
            Sound:Play()
            getgenv().MusicEnabled = true
            PlayIDBtn.Text = "停"
            PlayIDBtn.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
        end
    end
end)

-- 自动抛竿循环
task.spawn(function()
    while task.wait(getgenv().CastInterval or 2) do
        if getgenv().NWKZ_AutoCast then
            pcall(function()
                local char = lp.Character
                if char and not char:GetAttribute("Fishing") and not MainGui.Fishing.Visible then
                    RS.Events.Fishing:FireServer()
                end
            end)
        end
    end
end)

-- 锚定滑块循环
RunService.RenderStepped:Connect(function()
    if getgenv().NWKZ_Anchor then
        pcall(function()
            local fishingUI = MainGui.Fishing
            if fishingUI.Visible then
                local bar = fishingUI.BarFrame.Bar
                bar.Position = UDim2.new(0.5, 0, bar.Position.Y.Scale, 0)
                RS.Fishing:FireServer("1")
            end
        end)
    end
end)

-- 自动技能释放循环
task.spawn(function()
    while task.wait(getgenv().SkillInterval or 5) do
        if getgenv().AutoSkillZ then
            pcall(function()
                RS.Events.UseSkill:FireServer("Z")
            end)
        end
        if getgenv().AutoSkillX then
            pcall(function()
                RS.Events.UseSkill:FireServer("X")
            end)
        end
        if getgenv().AutoSkillC then
            pcall(function()
                RS.Events.UseSkill:FireServer("C")
            end)
        end
        if getgenv().AutoSkillV then
            pcall(function()
                RS.Events.UseSkill:FireServer("V")
            end)
        end
    end
end)

