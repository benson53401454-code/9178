-- 设置
local SettingsTab = Window:Tab({Title = "设置", Icon = "settings"})

SettingsTab:Slider({
    Title = "技能释放间隔（秒）",
    Step = 1,
    Value = {Min = 0, Max = 10, Default = 0},
    Callback = function(value)
        getgenv().SkillInterval = value
    end
})

-- 功能循环
task.spawn(function()
    while task.wait(10) do
        if getgenv().NWKZ_AutoCast then
            pcall(function()
                local char = lp.Character
                if char and not char:GetAttribute("Fishing") and not MainGui.Fishing.Visible then
                    RS.Events.Fishing:FireServer()
                end
            end)
        end
    end
end)

RunService.RenderStepped:Connect(function()
    if getgenv().NWKZ_Anchor then
        pcall(function()
            local fishingUI = MainGui.Fishing
            if fishingUI.Visible then
                local bar = fishingUI.BarFrame.Bar
                bar.Position = UDim2.new(0.5, 0, bar.Position.Y.Scale, 0)
                RS.Fishing:FireServer("1")
            end
        end)
    end
end)

task.spawn(function()
    while true do
        if getgenv().AutoSkillZ then pcall(function() RS.Events.UseSkill:FireServer("Z") end) end
        if getgenv().AutoSkillX then pcall(function() RS.Events.UseSkill:FireServer("X") end) end
        if getgenv().AutoSkillC then pcall(function() RS.Events.UseSkill:FireServer("C") end) end
        if getgenv().AutoSkillV then pcall(function() RS.Events.UseSkill:FireServer("V") end) end
        
        local interval = getgenv().SkillInterval or 0
        if interval <= 0 then task.wait() else task.wait(interval) end
    end
end)

task.spawn(function()
    while task.wait(0.1) do
        if getgenv().AutoBuyBait then
            pcall(function()
                RS.Events.BuyBait:FireServer("Ancestral Bait", 1)
            end)
        end
    end
end)

print("LOL Hub 已加载！")
