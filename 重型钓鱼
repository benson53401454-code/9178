-- 音乐标签页
local MusicTab = Window:Tab({Title = "音乐播放器", Icon = "music"})

MusicTab:Toggle({
    Title = "播放/停止音乐",
    Value = false,
    Callback = function(value)
        getgenv().MusicEnabled = value
        if value then
            if Sound then
                Sound:Play()
            else
                if getgenv().MusicID ~= "" then
                    Sound = Instance.new("Sound")
                    Sound.SoundId = "rbxassetid://" .. getgenv().MusicID
                    Sound.Volume = getgenv().MusicVolume or 0.5
                    Sound.Looped = true
                    Sound.Parent = lp.PlayerGui
                    Sound:Play()
                end
            end
        else
            if Sound then
                Sound:Stop()
            end
        end
    end
})

MusicTab:Slider({
    Title = "音量",
    Step = 0.1,
    Value = {Min = 0, Max = 1, Default = 0.5},
    Callback = function(value)
        getgenv().MusicVolume = value
        if Sound then
            Sound.Volume = value
        end
    end
})

-- 设置标签页
local SettingsTab = Window:Tab({Title = "设置", Icon = "settings"})

SettingsTab:Slider({
