-- LOL Hub - 带背景图 WindUI 版
local WindUI = loadstring(game:HttpGet("https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"))()

local lp = game:GetService("Players").LocalPlayer
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local MainGui = lp.PlayerGui:WaitForChild("MainGui")

getgenv().NWKZ_Anchor = false
getgenv().NWKZ_AutoCast = false
getgenv().AutoSkillZ = false
getgenv().AutoSkillX = false
getgenv().AutoSkillC = false
getgenv().AutoSkillV = false
getgenv().AutoBuyBait = false
getgenv().SkillInterval = 0

local Locations = {
    {Name = "初始岛屿", Pos = Vector3.new(-236.00, 6.76, 56.00)},
    {Name = "清湾岛", Pos = Vector3.new(-1226.00, 6.76, -23.00)},
    {Name = "核弹岛", Pos = Vector3.new(74.00, 6.76, 1216.00)},
    {Name = "主权岛屿", Pos = Vector3.new(-1285.00, 6.76, 1240.00)},
    {Name = "何罗鱼山崖", Pos = Vector3.new(-47.00, 9.28, -1337.00)},
    {Name = "极冰河", Pos = Vector3.new(-1348.00, 9.28, -1485.00)},
    {Name = "椰子岛", Pos = Vector3.new(1434.00, 9.28, -1433.00)},
    {Name = "琥珀岛", Pos = Vector3.new(1243.00, 6.76, 1393.00)},
    {Name = "长白山", Pos = Vector3.new(1543.00, 46.96, -51.00)},
    {Name = "哀牢山", Pos = Vector3.new(2632.16, 9.63, 53.21)},
}

local function Teleport(pos)
    local char = lp.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.CFrame = CFrame.new(pos)
    end
end

local Window = WindUI:CreateWindow({
    Title = "LOL Hub",
    Icon = "fish",
    Author = "",
    Folder = "AutoFisher",
    Size = UDim2.fromOffset(560, 550),
    Transparent = true,
    Theme = "Dark",
    User = {
        Enabled = false,
    },
})

Window:EditOpenButton({
    Title = "LOL Hub",
    Icon = "fish",
    CornerRadius = UDim.new(0,16),
    StrokeThickness = 2,
    Color = ColorSequence.new(
        Color3.fromHex("FFFFFF"),
        Color3.fromHex("FF0000")
    ),
    Draggable = true,
})

-- 添加背景图到窗口
task.spawn(function()
    wait(1)
    pcall(function()
        local windowFrame = Window.Main or Window.Container or Window.Content
        if windowFrame then
            local bg = Instance.new("ImageLabel")
            bg.Name = "BG"
            bg.Size = UDim2.new(1, 0, 1, 0)
            bg.Position = UDim2.new(0, 0, 0, 0)
            bg.BackgroundTransparency = 1
            bg.Image = "rbxassetid://132607724189951"
            bg.ScaleType = Enum.ScaleType.Crop
            bg.ImageTransparency = 0.7  -- 70%透明，不遮挡按钮
            bg.ZIndex = 0
            bg.Parent = windowFrame
        end
    end)
end)

-- 钓鱼功能
local MainTab = Window:Tab({Title = "钓鱼功能", Icon = "fish"})

MainTab:Toggle({
    Title = "锚定滑块（保持中间）",
    Value = false,
    Callback = function(value)
        getgenv().NWKZ_Anchor = value
    end
})

MainTab:Toggle({
    Title = "自动抛竿（10秒）",
    Value = false,
    Callback = function(value)
        getgenv().NWKZ_AutoCast = value
    end
})

MainTab:Toggle({
    Title = "自动购买祖传饵料",
    Value = false,
    Callback = function(value)
        getgenv().AutoBuyBait = value
    end
})

MainTab:Button({
    Title = "一键卖鱼",
    Callback = function()
        RS.Events.SellFish:FireServer("All")
    end
})

-- 传送功能
local TeleportTab = Window:Tab({Title = "传送功能", Icon = "map"})

for _, loc in pairs(Locations) do
    TeleportTab:Button({
        Title = loc.Name,
        Callback = function()
            Teleport(loc.Pos)
        end
    })
end

